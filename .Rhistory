install.packages("ggplot2")
library(ggplot2)
# Sample binary grid (0's and 1's)
set.seed(123)  # For reproducibility
grid <- matrix(sample(0:1, 100, replace = TRUE), nrow = 10)
# Define window size (3x3 for a 3x3 km dispersal)
window_size <- c(3, 3)
grid
window_size
# Function to calculate connectivity score for a given window
calculateConnectivity <- function(window) {
num_ones <- sum(window)
if (num_ones == prod(window_size)) {
return(1)  # Perfect connectivity
} else {
return(num_ones / prod(window_size))  # Connectivity score
}
}
# Initialize an empty matrix for storing connectivity scores
connectivity_scores <- matrix(0, nrow = nrow(grid) - window_size[1] + 1, ncol = ncol(grid) - window_size[2] + 1)
connectivity_scores
# Calculate connectivity scores
for (i in 1:(nrow(grid) - window_size[1] + 1)) {
for (j in 1:(ncol(grid) - window_size[2] + 1)) {
window <- grid[i:(i + window_size[1] - 1), j:(j + window_size[2] - 1)]
connectivity_scores[i, j] <- calculateConnectivity(window)
}
}
# Print or visualize the connectivity scores
print(connectivity_scores)
grid
# Define window size (3x3 for a 3x3 km dispersal)
window_size <- c(2, 2)
# Function to calculate connectivity score for a given window
calculateConnectivity <- function(window) {
num_ones <- sum(window)
if (num_ones == prod(window_size)) {
return(1)  # Perfect connectivity
} else {
return(num_ones / prod(window_size))  # Connectivity score
}
}
# Initialize an empty matrix for storing connectivity scores
connectivity_scores <- matrix(0, nrow = nrow(grid) - window_size[1] + 1, ncol = ncol(grid) - window_size[2] + 1)
# Calculate connectivity scores
for (i in 1:(nrow(grid) - window_size[1] + 1)) {
for (j in 1:(ncol(grid) - window_size[2] + 1)) {
window <- grid[i:(i + window_size[1] - 1), j:(j + window_size[2] - 1)]
connectivity_scores[i, j] <- calculateConnectivity(window)
}
}
# Print or visualize the connectivity scores
print(connectivity_scores)
